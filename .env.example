# ==============================================================================
# OmniResearch — Environment Configuration Template
# ==============================================================================

# AI Model Inference (GroqCloud API)
GROQ_API_KEY=your_groq_api_key_here
OMNI_MODEL=openai/gpt-oss-120b

# Web Search Provider (Tavily API)
TAVILY_API_KEY=your_tavily_api_key_here

# Production PostgreSQL Database (Render / Neon / Supabase)
# Set by Render automatically when creating a PostgreSQL database.
# If omitted or empty, OmniResearch safely falls back to local SQLite (omniresearch.db).
DATABASE_URL=postgresql://omni_user:your_password@dpg-xxx.oregon-postgres.render.com/omniresearch?sslmode=require

# Production Frontend URL (Vercel)
# Used to enforce CORS policy. Set to your deployed Vercel domain.
FRONTEND_URL=https://your-frontend.vercel.app

# Server Port (Injected automatically by Render at runtime)
PORT=8000
